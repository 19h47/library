{
	"name": "library",
	"private": true,
	"description": "Tools of the plugin: the tests of the reading app in a browser, and the checks of its scripts. The plugin itself needs no build.",
	"type": "module",
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"wp-env": "wp-env",
		"test:e2e": "playwright test",
		"lint:js": "eslint .",
		"check:js": "tsc --project jsconfig.json"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@types/node": "24.19.2",
		"@wordpress/a11y": "5.1.0",
		"@wordpress/api-fetch": "8.1.0",
		"@wordpress/e2e-test-utils-playwright": "3.2.0",
		"@wordpress/env": "12.1.0",
		"@wordpress/eslint-plugin": "28.1.0",
		"@wordpress/i18n": "7.1.0",
		"@wordpress/prettier-config": "5.1.0",
		"@wordpress/url": "5.1.0",
		"eslint": "10.14.0",
		"globals": "17.14.0",
		"prettier": "npm:wp-prettier@3.0.3",
		"typescript": "5.9.3"
	}
}

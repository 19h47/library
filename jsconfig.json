{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"target": "es2024",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": [ "es2024", "dom", "dom.iterable" ],
		"skipLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"library-app/*": [ "app/js/lib/*.js" ]
		}
	},
	"include": [ "app/js/**/*.js", "admin/js/*.js", "types/*.d.ts" ],
	"exclude": [ "app/js/library-app-service-worker.js" ]
}

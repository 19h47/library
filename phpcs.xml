<?xml version="1.0"?>
<ruleset name="Library-Standards">
    <description>WordPress standards for the Library plugin.</description>

    <file>.</file>

    <arg name="extensions" value="php" />

    <exclude-pattern>*/languages/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <rule ref="WordPress" />

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="library" />
            </property>
        </properties>
    </rule>
    <!-- The capabilities of the books and their names, which the roles of the readers give: see Roles. -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="shelve_book" />
                <element value="shelve_library_books" />
                <element value="manage_library_terms" />
            </property>
        </properties>
    </rule>
</ruleset>
